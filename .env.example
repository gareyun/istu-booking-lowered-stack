APP_NAME="ISTU Booking"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000

LOG_CHANNEL=stack
LOG_LEVEL=debug

# SQLite (по умолчанию) или MySQL — раскомментируйте нужное
DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=istu_booking
# DB_USERNAME=root
# DB_PASSWORD=

BROADCAST_DRIVER=log
CACHE_DRIVER=file
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

# Google Calendar — путь относительно storage/
GOOGLE_SERVICE_ACCOUNT_PATH=app/private/your-service-account.json
GOOGLE_CALENDAR_ROOM_9_2=
GOOGLE_CALENDAR_ROOM_floor_2=

# VK-бот (уведомления)
VK_ACCESS_TOKEN=
VK_COMMUNITY_ID=
